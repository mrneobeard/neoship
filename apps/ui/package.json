{
	"name": "ui",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "NODE_OPTIONS=--disable-warning=DEP0205 vp dev --host 0.0.0.0",
		"build": "NODE_OPTIONS=--disable-warning=DEP0205 vp build",
		"preview": "NODE_OPTIONS=--disable-warning=DEP0205 vp preview",
		"prepare": "NODE_OPTIONS=--disable-warning=DEP0205 svelte-kit sync || echo ''",
		"check": "NODE_OPTIONS=--disable-warning=DEP0205 svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "NODE_OPTIONS=--disable-warning=DEP0205 svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "NODE_OPTIONS=--disable-warning=DEP0205 vp test",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && NODE_OPTIONS=--disable-warning=DEP0205 playwright test"
	},
	"devDependencies": {
		"@types/node": "^24.2.0",
		"@fontsource-variable/figtree": "^5.2.10",
		"@hugeicons/core-free-icons": "^4.2.0",
		"@hugeicons/svelte": "^1.1.2",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@vitest/browser-playwright": "catalog:",
		"clsx": "^2.1.1",
		"playwright": "^1.59.1",
		"shadcn-svelte": "^1.3.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "^2.1.0"
	}
}
