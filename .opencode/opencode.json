{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "svelte": {
      "type": "local",
      "command": ["npx", "-y", "@sveltejs/mcp"],
      "enabled": false,
      "timeout": 10000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
      "timeout": 10000
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": false,
      "timeout": 10000
    },
    "openapi": {
      "type": "local",
      "command": ["npx", "-y", "@ivotoby/openapi-mcp-server"],
      "enabled": false,
      "timeout": 10000,
      "environment": {
        "API_BASE_URL": "http://localhost:5000",
        "OPENAPI_SPEC_PATH": "http://localhost:5000/openapi/v1.json",
        "TOOLS_MODE": "dynamic",
        "VERBOSE": "false"
      }
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": {},
      "timeout": 10000
    }
  }
}
